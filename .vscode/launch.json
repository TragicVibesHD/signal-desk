{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Signal Desk server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.mjs",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"],
      "env": {"PORT": "4317"}
    }
  ]
}
